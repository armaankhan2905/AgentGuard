# Relative SQLite paths resolve from backend/, regardless of the working directory.
DATABASE_URL=sqlite:///./data/agentguard.db
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required for live chat; health/status endpoints work without AI configuration.
# Copy the non-secret settings you need into backend/.env.
# Use openai or openai-compatible, and a model supporting Chat Completions tools.
# Configuration status does not verify credentials or provider connectivity.
AI_PROVIDER=openai
# Example model with documented function-calling support; account access must be verified.
AI_MODEL=gpt-4.1-mini
# Enter your actual API key ONLY in backend/.env after the equals sign.
# Deliberately blank here so this example cannot pretend to have credentials.
AI_API_KEY=
# Leave blank for openai (https://api.openai.com/v1).
# Required for openai-compatible: HTTPS API root including /v1 if needed.
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30
AGENT_MAX_TOOL_ITERATIONS=4
AGENT_CONTEXT_MESSAGES=40
AGENT_CONTEXT_CHARS=24000

# Monitoring and evaluation routes are absent unless BOTH settings below opt in.
# Bind Uvicorn to 127.0.0.1 with --no-proxy-headers. Never expose these routes publicly.
APP_ENVIRONMENT=production
SECURITY_DEV_ENDPOINTS=false
# Server-owned JSON; relative paths resolve from backend/. Invalid/missing = deny all.
SECURITY_POLICY_FILE=config/security_policies.json

# Mandatory deterministic scanning; invalid/missing policy quarantines content.
INJECTION_POLICY_FILE=config/injection_policy.json
# Optional advisory API call for medium-risk ambiguity. Disabled by default.
# One call per request-scoped gateway; no tools; cannot downgrade deterministic handling.
INJECTION_AI_CLASSIFIER_ENABLED=false
INJECTION_AI_TIMEOUT_SECONDS=3
