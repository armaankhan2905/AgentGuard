{
  "version": 1,
  "rules": [
    {"id": "DENY_CONFIDENTIAL_DOCUMENTS", "tool": "read_document", "effect": "DENY", "classification": "CONFIDENTIAL"},
    {"id": "DENY_RESTRICTED_DOCUMENTS", "tool": "read_document", "effect": "DENY", "classification": "RESTRICTED"},
    {"id": "ALLOW_PUBLIC_DOCUMENTS", "tool": "read_document", "effect": "ALLOW", "classification": "PUBLIC"},
